<svg width="1200" height="630" viewBox="0 0 1200 630" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="1200" height="630" fill="#050508"/>
  <rect x="0" y="0" width="1200" height="630" fill="url(#aurora)" opacity="0.3"/>
  <defs>
    <linearGradient id="aurora" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#06B6D4"/>
      <stop offset="50%" stop-color="#3B82F6"/>
      <stop offset="100%" stop-color="#A855F7"/>
    </linearGradient>
  </defs>
  <!-- Grid pattern -->
  <g opacity="0.05">
    <line x1="0" y1="0" x2="1200" y2="0" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="40" x2="1200" y2="40" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="80" x2="1200" y2="80" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="120" x2="1200" y2="120" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="160" x2="1200" y2="160" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="200" x2="1200" y2="200" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="240" x2="1200" y2="240" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="280" x2="1200" y2="280" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="320" x2="1200" y2="320" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="360" x2="1200" y2="360" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="400" x2="1200" y2="400" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="440" x2="1200" y2="440" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="480" x2="1200" y2="480" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="520" x2="1200" y2="520" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="560" x2="1200" y2="560" stroke="white" stroke-width="0.5"/>
    <line x1="0" y1="600" x2="1200" y2="600" stroke="white" stroke-width="0.5"/>
  </g>
  <!-- Glow orb -->
  <circle cx="600" cy="315" r="250" fill="url(#aurora)" opacity="0.12" filter="url(#blur)"/>
  <defs>
    <filter id="blur">
      <feGaussianBlur stdDeviation="80"/>
    </filter>
  </defs>
  <!-- Brand text -->
  <text x="600" y="260" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="96" font-weight="800" letter-spacing="-2" fill="white" opacity="0.97">ALLOCATOR</text>
  <text x="600" y="260" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="96" font-weight="800" letter-spacing="-2" fill="url(#aurora)" opacity="0.6" dx="80">.AI</text>
  <!-- Tagline -->
  <text x="600" y="340" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="400" fill="rgba(255,255,255,0.55)" letter-spacing="4">AGENTIC AI TRAINER ALLOCATION</text>
  <!-- Subtitle -->
  <text x="600" y="390" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="20" font-weight="300" fill="rgba(255,255,255,0.35)" letter-spacing="1">Powered by Gemini 1.5 Pro &amp; Supabase pgvector</text>
  <!-- Bottom bar -->
  <rect x="300" y="450" width="600" height="1" fill="rgba(255,255,255,0.08)"/>
  <!-- Stats -->
  <text x="600" y="490" text-anchor="middle" font-family="monospace" font-size="14" font-weight="400" fill="rgba(255,255,255,0.35)">99.4% Match Accuracy  •  &lt;4s Allocation  •  4,800+ Trainers</text>
</svg>
